<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.cs.mpgc.rpg125950.lupusintabula.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="playerNameLabel" text="Nome giocatore"/>
    <TextField fx:id="playerNameField" text="Tu"
               promptText="Inserisci il tuo nome"/>
    <HBox spacing="8.0">
        <Button fx:id="createGameButton" text="Inizia partita" onAction="#onCreaPartitaClick"/>
    </HBox>

    <Label fx:id="phaseLabel" visible="false"/>
    <Label fx:id="roleLabel"/>
    <ListView fx:id="playersList" visible="false"/>

    <HBox fx:id="playerActions" visible="false" spacing="8.0">
        <Button fx:id="voteButton" text="Vota" onAction="#onVotaClick"/>
        <Button fx:id="buttonAttacca" text="Attacca" onAction="#onAttaccoClick"/>
        <Button fx:id="inspectButton" text="Controlla" onAction="#onIspezionaClick"/>
        <Button fx:id="advancePhaseButton" text="Avanza fase" onAction="#onAvanzaFaseClick"/>
    </HBox>

    <ListView fx:id="logList" visible="false" VBox.vgrow="ALWAYS"/>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
