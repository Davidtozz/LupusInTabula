<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.cs.mpgc.rpg125950.lupusintabula.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Nome giocatore"/>
    <TextField fx:id="playerNameField" text="Tu"
               promptText="Inserisci il tuo nome"/>
    <HBox spacing="8.0">
        <Button fx:id="createGameButton" text="Inizia partita" onAction="#onCreateGameClick"/>
    </HBox>

    <Label fx:id="phaseLabel"/>
    <Label fx:id="roleLabel"/>
    <ListView fx:id="playersList" prefHeight="180.0"/>

    <HBox spacing="8.0">
        <Button fx:id="wolvesAttackButton" text="Attacca" onAction="#onWolvesAttackClick"/>
        <Button fx:id="inspectButton" text="Controlla" onAction="#onInspectClick"/>
        <Button fx:id="advanceAiButton" text="Avanza giocatori" onAction="#onAdvanceAiClick"/>
        <Button fx:id="voteButton" text="Vota" onAction="#onVoteClick"/>
        <Button fx:id="advancePhaseButton" text="(debug) Avanza fase" onAction="#onAdvancePhaseClick"/>
    </HBox>

    <ListView fx:id="logList" prefHeight="120.0"/>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
